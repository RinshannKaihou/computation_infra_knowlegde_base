{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source registry",
  "type": "object",
  "required": ["schema_version", "sources"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "sources": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "title", "url", "kind", "registered_at", "license", "notes"],
        "properties": {
          "id": {"type": "string", "pattern": "^src\\.[a-z0-9]+(?:[.-][a-z0-9]+)+$"},
          "title": {"type": "string", "minLength": 1},
          "url": {"type": "string", "format": "uri", "pattern": "^https?://"},
          "kind": {"enum": ["repository", "documentation", "paper", "issue", "experiment"]},
          "registered_at": {"type": "string", "format": "date"},
          "revision": {"type": ["string", "null"]},
          "license": {
            "type": "object", "additionalProperties": false,
            "required": ["status", "notes", "scopes"],
            "properties": {
              "status": {"enum": ["unknown", "partial", "identified"]},
              "notes": {"type": "string", "minLength": 1},
              "scopes": {
                "type": "array",
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["scope", "identifier", "url"],
                  "properties": {
                    "scope": {"type": "string", "minLength": 1},
                    "identifier": {"type": "string", "minLength": 1},
                    "url": {"type": "string", "format": "uri", "pattern": "^https?://"}
                  }
                }
              }
            }
          },
          "notes": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
